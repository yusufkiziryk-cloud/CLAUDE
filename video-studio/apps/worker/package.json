  "dependencies": {
    "@studio/provider-mock": "workspace:*",
    "@studio/provider-sdk": "workspace:*",
    "@studio/shared": "workspace:*",
    "bullmq": "^5.34.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^9.18.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.4"
  }
}
