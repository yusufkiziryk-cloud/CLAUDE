# ---- Çekirdek ----
# memory: harici servis gerektirmez (geliştirme). prisma: PostgreSQL gerekir.
STORAGE_DRIVER=memory
# memory: süreç içi kuyruk (geliştirme). redis: BullMQ + Redis gerekir (ayrı worker süreci).
QUEUE_DRIVER=memory

# ---- PostgreSQL (STORAGE_DRIVER=prisma iken zorunlu) ----
DATABASE_URL=postgresql://studio:studio@localhost:5432/video_studio

# ---- Redis (QUEUE_DRIVER=redis iken zorunlu) ----
REDIS_URL=redis://localhost:6379

# ---- Nesne depolama ----
# disk: yerel DATA_DIR/objects (geliştirme/masaüstü). s3: MinIO/AWS S3 (aşağıdaki değerler zorunlu).
OBJECT_STORE=disk
# Ortak veri dizini (renders + objects). redis kuyruğu + disk deposunda API ve worker
# AYNI DATA_DIR'i kullanmalıdır; dağıtık kurulumda OBJECT_STORE=s3 kullanın.
# DATA_DIR=/mutlak/yol/data
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=video-studio

# ---- API ----
API_PORT=4000
API_HOST=127.0.0.1
# Geliştirme modu auth: tek kullanıcı. Üretimde gerçek auth zorunlu (Faz sonrası).
DEV_USER_EMAIL=dev@localhost

# ---- Güvenlik / limitler (Faz 8) ----
# CORS bu origin'e daraltılır (web arayüzünün adresi).
WEB_ORIGIN=http://localhost:3000
# IP başına dakikalık istek sınırı. 0 → kapalı (yalnızca güvenilir ağda!).
RATE_LIMIT_PER_MIN=300
# Tek dosya yükleme üst sınırı (MiB).
UPLOAD_MAX_MB=200
# Bitmiş iş/varlık saklama süresi (gün). Tanımsızsa otomatik silme KAPALI.
# Sahne/timeline'da hâlâ kullanılan varlıklar süresi dolsa da silinmez.
# DATA_RETENTION_DAYS=30

# ---- Web ----
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---- Sağlayıcı anahtarları (BYOK — asla commit etmeyin) ----
# Anahtar tanımlanmayan sağlayıcı KAYDEDİLMEZ; arayüzde görünmez (mock her zaman açık).
# fal.ai anahtarı: https://fal.ai/dashboard/keys
# FAL_API_KEY=
# OpenAI anahtarı: https://platform.openai.com/api-keys
# OPENAI_API_KEY=
# Replicate anahtarı: https://replicate.com/account/api-tokens
# REPLICATE_API_TOKEN=
# ElevenLabs anahtarı: https://elevenlabs.io (profil > API anahtarları)
# ELEVENLABS_API_KEY=
