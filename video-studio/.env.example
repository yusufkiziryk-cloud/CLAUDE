# ---- Çekirdek ----
# memory: harici servis gerektirmez (geliştirme). prisma: PostgreSQL gerekir.
STORAGE_DRIVER=memory
# memory: süreç içi kuyruk (geliştirme). redis: BullMQ + Redis gerekir (ayrı worker süreci).
QUEUE_DRIVER=memory

# ---- PostgreSQL (STORAGE_DRIVER=prisma iken zorunlu) ----
DATABASE_URL=postgresql://studio:studio@localhost:5432/video_studio

# ---- Redis (QUEUE_DRIVER=redis iken zorunlu) ----
REDIS_URL=redis://localhost:6379

# ---- Nesne depolama (S3/MinIO — Faz 5'te etkinleşir; şimdilik yerel disk) ----
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=video-studio

# ---- API ----
API_PORT=4000
API_HOST=127.0.0.1
# Geliştirme modu auth: tek kullanıcı. Üretimde gerçek auth zorunlu (Faz sonrası).
DEV_USER_EMAIL=dev@localhost

# ---- Web ----
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---- Sağlayıcı anahtarları (BYOK — asla commit etmeyin) ----
# Faz 2'de gerçek adaptörlerle kullanılacak. Mock sağlayıcı anahtar gerektirmez.
# FAL_API_KEY=
# OPENAI_API_KEY=
