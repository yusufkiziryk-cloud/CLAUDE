generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id                String    @id
  name              String
  purpose           String
  aspectRatio       String
  targetDurationSec Int
  language          String    @default("tr")
  resolution        String    @default("1080p")
  style             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  promptVersions PromptVersion[]
  assets         Asset[]
  generationJobs GenerationJob[]
}

model PromptVersion {
  id        String   @id
  promptId  String
  projectId String
  version   Int
  language  String   @default("tr")
  /// VideoPrompt gövdesi (Zod ile doğrulanmış JSON)
  body      Json
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id])

  @@unique([promptId, version])
  @@index([projectId])
}

model Asset {
  id           String    @id
  projectId    String
  kind         String
  name         String
  uri          String
  mimeType     String
  sizeBytes    Int
  sha256       String?
  durationSec  Float?
  width        Int?
  height       Int?
  thumbnailUri String?
  /// Provenance JSON (providerId, modelId, mock bayrağı, maliyet...)
  provenance   Json?
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  project Project @relation(fields: [projectId], references: [id])

  @@index([projectId])
}

model CreativeBrief {
  id          String   @id
  projectId   String   @unique
  audience    String
  goal        String
  tone        String
  platform    String
  cta         String?
  /// string[] JSON
  keyMessages Json
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Script {
  id        String   @id
  projectId String
  briefId   String?
  format    String
  generator String
  title     String
  /// ScriptSection[] JSON
  sections  Json
  createdAt DateTime @default(now())

  @@index([projectId])
}

model Scene {
  id                String   @id
  projectId         String
  scriptId          String
  order             Int
  title             String
  summary           String
  narration         String
  durationSec       Float
  locationName      String?
  timeOfDay         String?
  /// string[] JSON
  characterNames    Json
  /// VideoPrompt JSON
  prompt            Json
  storyboardJobId   String?
  storyboardAssetId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([projectId, order])
  @@index([scriptId])
}

model BibleCard {
  id               String   @id
  projectId        String
  kind             String
  name             String
  description      String
  promptFragment   String?
  isRealPerson     Boolean  @default(false)
  consentConfirmed Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([projectId])
}

model Sequence {
  id        String   @id
  projectId String   @unique
  name      String
  fps       Int      @default(24)
  width     Int      @default(1280)
  height    Int      @default(720)
  /// TimelineTrack[] JSON
  tracks    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RenderJob {
  id         String    @id
  projectId  String
  sequenceId String
  preset     String
  status     String
  progress   Int       @default(0)
  error      Json?
  outputPath String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  finishedAt DateTime?

  @@index([projectId])
}

model PromptTemplate {
  id          String   @id
  name        String
  description String?
  /// VideoPrompt gövdesi (Zod ile doğrulanmış JSON)
  body        Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GenerationJob {
  id              String    @id
  projectId       String
  promptVersionId String?
  /// CanonicalGenerationRequest JSON'u
  request         Json
  status          String
  progress        Int       @default(0)
  idempotencyKey  String    @unique
  costEstimate    Json?
  actualCostUsd   Float?
  error           Json?
  resultAssetIds  String[]  @default([])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  startedAt       DateTime?
  finishedAt      DateTime?

  project Project @relation(fields: [projectId], references: [id])

  @@index([projectId, status])
}
