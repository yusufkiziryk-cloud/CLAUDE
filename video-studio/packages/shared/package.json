{
  "name": "@studio/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./prisma": {
      "types": "./dist/storage/prisma.d.ts",
      "default": "./dist/storage/prisma.js"
    }
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@prisma/client": "^6.19.0",
    "@studio/domain": "workspace:*",
    "@studio/provider-fal": "workspace:*",
    "@studio/provider-mock": "workspace:*",
    "@studio/provider-openai": "workspace:*",
    "@studio/provider-sdk": "workspace:*",
    "@studio/media-engine": "workspace:*",
    "@studio/provider-replicate": "workspace:*",
    "@studio/provider-elevenlabs": "workspace:*"
  },
  "devDependencies": {
    "@studio/test-utils": "workspace:*",
    "@types/node": "^22.10.0",
    "eslint": "^9.18.0",
    "prisma": "^6.19.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.4"
  }
}
