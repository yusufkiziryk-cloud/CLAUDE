.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Runtime state: databases, logs and downloaded market data are per-machine.
user_data/dryrun/
user_data/backtest/
user_data/live/
user_data/logs/
user_data/data/
user_data/backtest_results/
user_data/hyperopt_results/

# Generated reports keep their manifests in git, not their bulk output.
reports/**/raw/
# The dashboard is regenerated from the artefacts on disk; the generator and
# its template are what belong in git, not the 80KB of baked-in data.
reports/dashboard.html

# Never commit secrets, even by accident.
.env
.env.*
!.env.example
*.key
*.pem
