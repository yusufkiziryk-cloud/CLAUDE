.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Runtime state: databases, logs and downloaded market data are per-machine.
user_data/dryrun/
user_data/backtest/
backups/
user_data/live/
user_data/logs/
user_data/data/
user_data/backtest_results/
user_data/hyperopt_results/

# Generated reports keep their manifests in git, not their bulk output.
reports/**/raw/
# The dashboard is regenerated from the artefacts on disk; the generator and
# its template are what belong in git, not the 80KB of baked-in data.
reports/dashboard.html

# Never commit secrets, even by accident.
.env
.env.*
!.env.example
*.key
*.pem
# Operator overlays that carry a token (Telegram, notifications) live next to
# the tracked configs; name them *.local.json and they can never be committed.
config/*.local.json
config/*telegram*
config/*notify*
config/*secret*
# freqtrade picks up ./config.json when no --config is given; a stray copy
# here is a landmine next to the safe configuration.
config.json
user_data/config.json
