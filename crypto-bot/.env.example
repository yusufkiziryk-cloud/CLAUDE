# Example environment file. CONTAINS NO REAL SECRETS AND MUST NEVER CONTAIN ANY.
#
# For dry-run research you need NOTHING from this file. The bot starts,
# downloads public market data and simulates trades with no credentials at all.
#
# Telegram notifications are optional. If you want them, set these two in a
# file that is NOT committed, and remember that scripts/safe-run.py will warn
# that notifications are enabled.
# FREQTRADE__TELEGRAM__ENABLED=true
# FREQTRADE__TELEGRAM__TOKEN=
# FREQTRADE__TELEGRAM__CHAT_ID=
#
# Do NOT put exchange credentials here. scripts/safe-run.py refuses to start
# if any FREQTRADE__*KEY*/*SECRET*/*WALLET* variable is present, and refuses
# if FREQTRADE__DRY_RUN is set to false.
